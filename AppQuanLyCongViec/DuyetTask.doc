sequenceDiagram
    actor Admin
    participant App_Admin as "CollabTask App (Admin)"
    participant Server
    participant Notification_Service as "Notification Service"
    participant App_User as "CollabTask App (User)"
    actor User

    title Use Case 5: Admin Approves Task

    Admin ->> App_Admin: 1. Clicks 'Approve' on task
    App_Admin ->> Server: 2. PUT /api/tasks/{id} (status: 'Done')
    
    activate Server
    Server ->> Server: 3. Update task status in DB
    Server -->> App_Admin: 4. Response: {OK}
    deactivate Server
    
    %% Notify User
    Server ->> Notification_Service: 5. Trigger notifyUser(userId, taskId, "approved")
    
    activate Notification_Service
    Notification_Service ->> App_User: 6. Push Notification ("Task Approved!")
    deactivate Notification_Service
    
    App_User ->> User: 7. Show notification
    
    %% Real-time update
    Server ->> App_User: 8. (WebSocket) 'TASK_UPDATED' (status: 'Done')
    App_User ->> User: 9. Update UI (Task moves to 'Done')