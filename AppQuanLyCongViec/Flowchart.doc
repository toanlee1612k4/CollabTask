%% Sơ đồ Luồng Cải tiến: Xử lý các trường hợp phức tạp
flowchart TD
    %% Định nghĩa các Node Kết thúc
    F_End_Done((Hoàn thành))
    F_End_Canceled((Đã Hủy))

    %% Làn của Admin
    subgraph Admin
        A_Start((Bắt đầu))
        A_Create[Tạo công việc]
        A_Setup[Thiết lập chi tiết]
        A_Assign[Gán cho Thành viên]
        
        A_ReceiveReview["Nhận thông báo 'Cần duyệt'"]
        A_Review["Kiểm tra/Duyệt Task"]
        A_Decision_Review{"Kết quả OK?"}
        A_Done["Set trạng thái 'Done'"]
        
        A_Feedback["Thêm bình luận (Feedback)"]
        A_Return["Trả về 'In Progress' / 'To Do'"]
        
        A_ReceiveReject["Nhận thông báo 'Cần Info' / 'Từ chối'"]
        A_HandleReject{"Xử lý phản hồi?"}
        A_Clarify["Bổ sung thông tin / Thuyết phục"]
        A_Reassign["Gán cho người khác"]
        A_Cancel["Set trạng thái 'Canceled'"]
    end

    %% Làn của Hệ thống (Tác vụ)
    subgraph System [System - Actions]
        S_Save[Lưu Task vào Database]
        S_Notify_User[Gửi thông báo 'Task mới' đến Thành viên]
        S_Notify_Admin_Review["Gửi thông báo 'Cần duyệt' đến Admin"]
        S_Notify_Admin_Reject["Gửi thông báo 'Task bị từ chối' đến Admin"]
        S_Notify_User_Update["Gửi thông báo 'Task được cập nhật'"]
        S_Notify_User_Cancel["Gửi thông báo 'Task đã bị hủy'"]
    end
    
    %% Làn của Hệ thống (Hẹn giờ)
    subgraph System_Timer [System - Timed Events]
        T_Start("Timer: Chờ đến Deadline")
        T_Check{"Task 'Done' chưa?"}
        T_SetOverdue["Set trạng thái 'Overdue'"]
        T_NotifyOverdue["Thông báo (Admin + User) Task quá hạn"]
    end

    %% Làn của Thành viên
    subgraph "Thành viên (Assignee)"
        U_Receive[Nhận thông báo Task mới]
        U_View[Xem chi tiết Task]
        U_Decision_Accept{"Chấp nhận Task?"}
        
        U_Reject["Set 'Cần thông tin' / 'Từ chối'"]
        U_AddReason["Thêm bình luận (lý do)"]
        
        U_StartWork["Set 'In Progress'"]
        U_Loop{"Công việc chưa xong?"}
        U_DoWork[Thực hiện công việc]
        U_Submit["Set 'In Review'"]
        U_Receive_Cancel["Nhận thông báo Hủy Task"]
    end

    %% --- Liên kết các luồng (Flows) ---

    %% 1. Luồng chính (Happy Path)
    A_Start --> A_Create --> A_Setup --> A_Assign
    A_Assign --> S_Save
    S_Save --> S_Notify_User
    S_Notify_User --> U_Receive
    U_Receive --> U_View
    U_View --> U_Decision_Accept
    
    U_Decision_Accept -- "Yes (Chấp nhận)" --> U_StartWork
    U_StartWork --> U_Loop
    U_Loop -- "Chưa xong" --> U_DoWork --> U_Loop
    U_Loop -- "Đã xong" --> U_Submit
    U_Submit --> S_Notify_Admin_Review
    S_Notify_Admin_Review --> A_ReceiveReview
    A_ReceiveReview --> A_Review --> A_Decision_Review
    
    A_Decision_Review -- "Yes (OK)" --> A_Done
    A_Done --> F_End_Done

    %% 2. Luồng Phản hồi (Feedback Loop)
    A_Decision_Review -- "No (Cần sửa)" --> A_Feedback
    A_Feedback --> A_Return
    A_Return --> S_Notify_User_Update
    S_Notify_User_Update --> U_View

    %% 3. Luồng Từ chối (Rejection Flow)
    U_Decision_Accept -- "No (Từ chối / Cần Info)" --> U_Reject
    U_Reject --> U_AddReason
    U_AddReason --> S_Notify_Admin_Reject
    S_Notify_Admin_Reject --> A_ReceiveReject
    A_ReceiveReject --> A_HandleReject
    
    A_HandleReject -- "Bổ sung thông tin" --> A_Clarify
    A_Clarify --> S_Notify_User_Update
    
    A_HandleReject -- "Gán lại" --> A_Reassign
    %% SỬA LỖI: Chuyển comment này xuống dòng riêng
    %% Quay lại luồng gán task
    A_Reassign --> A_Assign
    
    A_HandleReject -- "Hủy Task" --> A_Cancel

    %% 4. Luồng Hủy (Cancellation Flow)
    A_Cancel --> S_Notify_User_Cancel
    S_Notify_User_Cancel --> U_Receive_Cancel
    U_Receive_Cancel --> F_End_Canceled
    %% Admin cũng có thể Hủy Task ở bất kỳ đâu (Khó thể hiện, ví dụ: U_StartWork -...-> A_Cancel)

    %% 5. Luồng Quá hạn (Overdue Flow) - Chạy song song
    S_Save --> T_Start
    T_Start --> T_Check
    T_Check -- "Chưa" --> T_SetOverdue
    T_SetOverdue --> T_NotifyOverdue
    
    %% SỬA LỖI: Chuyển comment này xuống dòng riêng
    %% Dừng timer
    T_Check -- "Đã Done/Canceled" --> F_End_Done