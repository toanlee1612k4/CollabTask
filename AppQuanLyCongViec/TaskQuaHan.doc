sequenceDiagram
    participant System_Job as "System Job (Cron)"
    participant Server
    participant Notification_Service as "Notification Service"
    participant App_User as "CollabTask App (User)"
    participant App_Admin as "CollabTask App (Admin)"

    title Use Case 8: System Handles Overdue Task
    
    activate System_Job
    System_Job ->> Server: 1. GET /api/tasks/find-overdue
    
    activate Server
    Server ->> Server: 2. Query DB (deadline < now AND status NOT IN ('Done', 'Canceled'))
    Server -->> System_Job: 3. Response: [List of overdue tasks]
    deactivate Server

    loop For each task in list
        System_Job ->> Server: 4. PUT /api/tasks/{id} (status: 'Overdue')
        activate Server
        Server ->> Server: 5. Update task status in DB
        
        %% Notify both
        Server ->> Notification_Service: 6. Trigger notifyUser(userId, "overdue")
        Server ->> Notification_Service: 7. Trigger notifyAdmin(adminId, "overdue")
        
        %% Real-time updates
        Server ->> App_User: 8. (WebSocket) 'TASK_UPDATED' (status: 'Overdue')
        Server ->> App_Admin: 9. (WebSocket) 'TASK_UPDATED' (status: 'Overdue')
        
        Server -->> System_Job: 10. Response: {OK}
        deactivate Server
    end
    deactivate System_Job