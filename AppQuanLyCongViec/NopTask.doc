sequenceDiagram
    actor User
    participant App_User as "CollabTask App (User)"
    participant Server
    participant Notification_Service as "Notification Service"
    participant App_Admin as "CollabTask App (Admin)"
    actor Admin

    title Use Case 3: User Submits Task for Review

    User ->> App_User: 1. Drag task to 'In Review'
    App_User ->> Server: 2. PUT /api/tasks/{id} (status: 'InReview')
    
    activate Server
    Server ->> Server: 3. Update task status in DB
    Server -->> App_User: 4. Response: {OK}
    deactivate Server
    
    %% Notify Admin
    Server ->> Notification_Service: 5. Trigger notifyAdmin(adminId, taskId)
    
    activate Notification_Service
    Notification_Service ->> App_Admin: 6. Push Notification ("Task needs review")
    deactivate Notification_Service
    
    App_Admin ->> Admin: 7. Show notification
    
    %% Real-time update for Admin's board
    Server ->> App_Admin: 8. (WebSocket) 'TASK_UPDATED' (status: 'InReview')
    App_Admin ->> Admin: 9. Update UI (Task moves to 'In Review')