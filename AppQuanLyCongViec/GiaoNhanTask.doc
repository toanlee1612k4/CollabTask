%% Sơ đồ Tuần tự: Giao Task và Thông báo
sequenceDiagram
    actor Admin
    participant App_Client as "CollabTask App (Admin)"
    participant Server
    participant Notification_Service as "Dịch vụ Thông báo"
    participant App_Client_User as "CollabTask App (Thành viên)"
    actor User as "Thành viên"

    title Quy trình Giao Task và Thông báo (Sequence Diagram)

    Admin ->> App_Client: 1. Tạo và gán Task (chọn Assignee)
    App_Client ->> Server: 2. POST /api/tasks (data: {..., assigneeId: 'UserB'})
    
    activate Server
    Server ->> Server: 3. Xử lý logic, xác thực
    Server ->> Server: 4. Lưu Task vào Database (trạng thái 'To Do')
    Server -->> App_Client: 5. Response: {Task đã tạo}
    deactivate Server
    
    %% Luồng thông báo bất đồng bộ
    Server ->> Notification_Service: 6. Trigger: sendNewTaskNotification(to: 'UserB', task: 'Task A')
    
    activate Notification_Service
    Notification_Service -->> Server: 7. Ack (Đã nhận yêu cầu)
    Notification_Service ->> App_Client_User: 8. Gửi Push Notification (Firebase/APNs)
    deactivate Notification_Service
    
    App_Client_User ->> User: 9. Hiển thị thông báo (Notification)
    
    User ->> App_Client_User: 10. Mở app, xem Task
    App_Client_User ->> Server: 11. GET /api/tasks/taskId
    
    activate Server
    Server -->> App_Client_User: 12. Response: {Chi tiết Task A}
    deactivate Server
    
    User ->> App_Client_User: 13. Bắt đầu làm (Kéo sang 'In Progress')
    App_Client_User ->> Server: 14. PUT /api/tasks/taskId (data: {status: 'In Progress'})
    
    activate Server
    Server ->> Server: 15. Cập nhật trạng thái Task
    Server -->> App_Client_User: 16. Response: {OK}
    
    %% Thông báo cập nhật cho Admin (Real-time)
    Server ->> App_Client: 17. (WebSocket Event) 'TASK_UPDATED' (data: {taskId, status: 'In Progress'})
    deactivate Server
    
    App_Client ->> Admin: 18. Cập nhật UI (Task A đang 'In Progress')