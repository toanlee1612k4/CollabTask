sequenceDiagram
    actor User
    participant App_User as "CollabTask App (User)"
    participant Server
    participant Notification_Service as "Notification Service"
    participant App_Admin as "CollabTask App (Admin)"
    actor Admin

    title Use Case 4: User Rejects Task

    User ->> App_User: 1. Click 'Reject' (adds comment)
    App_User ->> Server: 2. PUT /api/tasks/{id} (status: 'Rejected', comment: '...')
    
    activate Server
    Server ->> Server: 3. Update status & save comment
    Server -->> App_User: 4. Response: {OK}
    deactivate Server
    
    %% Notify Admin
    Server ->> Notification_Service: 5. Trigger notifyAdmin(adminId, taskId, "rejected")
    
    activate Notification_Service
    Notification_Service ->> App_Admin: 6. Push Notification ("Task was rejected")
    deactivate Notification_Service
    
    App_Admin ->> Admin: 7. Show notification
    
    %% Real-time update
    Server ->> App_Admin: 8. (WebSocket) 'TASK_UPDATED' (status: 'Rejected')
    App_Admin ->> Admin: 9. Update UI